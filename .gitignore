# ==========================================
# Universal .gitignore — C/C++, Python, Go,
# Rust, Web (HTML/CSS/JS/Node)
# Personal convention: *.local files always ignored
# ==========================================

# ---- Local-only convention ----
*.local
*.local.*
.local/

# ---- OS junk (macOS/Windows) ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- OS junk (Linux) ----
.directory
.fuse_hidden*
.nfs*

# ---- Editor / IDE ----
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*.swn
*~
.netrwhist
*.sublime-workspace
*.sublime-project

# ---- Env files ----
.env
.env.*
!.env.example

# ---- Keys / certs ----
*.pem
*.key
*.crt
*.p12
!*.pub.key
secrets.*
credentials.*

# ---- Logs ----
*.log

# ---- Temp / backup files ----
*.tmp
*.bak
*.orig
.cache/
tmp/
temp/

# ---- Local databases ----
*.sqlite
*.sqlite3
*.db

# ---- C/C++ compiled objects ----
*.o
*.obj
*.lo
*.slo
*.ko
*.elf
*.so
*.so.*
*.dylib
*.dll
*.a
*.la
*.lai

# ---- C/C++ binaries ----
*.exe
*.out
*.app
*.stackdump

# ---- C/C++ preprocessed / debug ----
*.i
*.ii
*.gch
*.pch
*.su
*.idb
*.pdb
*.dSYM/

# ---- C/C++ coverage / profiling ----
*.gcno
*.gcda
*.gcov

# ---- C/C++ build systems ----
compile_commands.json
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
cmake-build-*/
Makefile
!Makefile.am
build/

# ---- Python bytecode / cache ----
__pycache__/
*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/

# ---- Python packaging ----
*.egg-info/
*.egg
.eggs/
dist/
build/
*.whl
pip-log.txt

# ---- Python virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Python coverage ----
.coverage
.coverage.*
htmlcov/

# ---- Go binaries / build output ----
*.exe~
*.test
*.prof
/bin/
/vendor/

# ---- Go debugger (Delve) ----
__debug_bin*

# ---- Go workspace files ----
go.work
go.work.sum

# ---- Rust build output ----
/target/
*.pdb
**/*.rs.bk

# ---- Rust lockfile (kept for binaries; remove line below to ignore) ----
Cargo.lock
!Cargo.lock

# ---- Web/Node dependencies ----
node_modules/
jspm_packages/
.pnpm-store/

# ---- Web/Node logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Web/Node build output ----
dist/
build/
.next/
.nuxt/
.svelte-kit/
.parcel-cache/
.turbo/
.vite/

# ---- Web/Node cache / lint ----
*.tsbuildinfo
.eslintcache
.stylelintcache
coverage/

# ---- Archives / misc ----
*.zip
*.tar.gz
*.7z
